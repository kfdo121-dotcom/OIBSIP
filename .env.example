# ---------------------------------------------------------------- server ----
NODE_ENV=development
PORT=5000

# MongoDB. Local standalone works, but a replica set (transactions) is preferred:
#   mongod --replSet rs0
# MONGO_URI=mongodb://127.0.0.1:27017/pizza_platform?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/pizza_platform

# ------------------------------------------------------------------ auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
JWT_ISSUER=pizza-platform

# ---------------------------------------------------------------- admin ----
# Used by `npm run seed:admin` and as the recipient of low-stock alerts.
ADMIN_EMAIL=admin@pizza.local
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=Inventory Admin

# ------------------------------------------------------------------ mail ----
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Pizza Platform <no-reply@pizza.local>
# Also append every email to server/logs/mail.log so links are recoverable.
MAIL_LOG_TO_FILE=true

# -------------------------------------------------------------- razorpay ----
# TEST mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# -------------------------------------------------------------- inventory ---
# Fallback reorder threshold; every item can override it from the admin UI.
STOCK_DEFAULT_THRESHOLD=20
# node-cron expression for the low-stock sweep.
STOCK_ALERT_CRON=*/10 * * * *
STOCK_ALERT_ENABLED=true

# ----------------------------------------------------------------- client ---
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Set to true ONLY for automated test suites; lifts the auth rate limits.
DISABLE_RATE_LIMIT=false
